PORT=3001
NODE_ENV=development

# PostgreSQL - Supabase (pega tu connection string aquí)
DATABASE_URL=postgresql://usuario:password@host:5432/inventario

# CORS - URL del frontend en Vercel
FRONTEND_URL=https://tu-app.vercel.app

# Solo para desarrollo con PostgreSQL local sin SSL:
# DB_SSL=false

# --- Login ---
# Secreto para firmar las sesiones (texto largo y aleatorio, mínimo 32 caracteres)
JWT_SECRET=
# Duración de la sesión (opcional, por defecto 12h)
# JWT_DURACION=12h
# Administrador inicial: se crea solo si la tabla de usuarios está vacía
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
